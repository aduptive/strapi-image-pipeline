{
  "name": "@aduptive/strapi-image-pipeline",
  "version": "1.0.0-alpha.2",
  "description": "Resize, optimize and sanitize images in the Strapi upload pipeline, with programmable before/after transforms.",
  "license": "MIT",
  "author": "aduptive",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aduptive/strapi-image-pipeline.git"
  },
  "homepage": "https://github.com/aduptive/strapi-image-pipeline#readme",
  "bugs": "https://github.com/aduptive/strapi-image-pipeline/issues",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "image",
    "image-pipeline",
    "webp",
    "svg",
    "sharp",
    "upload",
    "media"
  ],
  "main": "strapi-server.js",
  "files": [
    "dist",
    "strapi-admin.js",
    "strapi-server.js",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./strapi-admin": {
      "import": "./dist/admin.mjs",
      "require": "./dist/admin.cjs",
      "default": "./dist/admin.mjs"
    },
    "./strapi-server": {
      "require": "./strapi-server.js",
      "default": "./strapi-server.js"
    },
    "./package.json": "./package.json",
    "./hooks": {
      "types": "./dist/hooks.d.ts"
    }
  },
  "strapi": {
    "name": "image-pipeline",
    "displayName": "Image Pipeline",
    "kind": "plugin",
    "description": "Optimize, convert and sanitize uploads, and run your own image transforms before they are stored."
  },
  "engines": {
    "node": ">=20.9 <21"
  },
  "peerDependencies": {
    "@strapi/strapi": ">=4.24.0 <5",
    "@strapi/design-system": "^1.19.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "styled-components": "^5.3.0",
    "react-intl": "^6.0.0",
    "@strapi/helper-plugin": ">=4.24.0 <5",
    "@strapi/utils": ">=4.24.0 <5"
  },
  "dependencies": {
    "sharp": "0.35.4",
    "dompurify": "^3.4.15",
    "jsdom": "^24.1.3",
    "svgo": "^4.1.0"
  }
}
